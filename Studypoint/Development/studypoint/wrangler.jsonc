{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Renamed from "studypoint" on 2026-11-26: served at studyflare.r279.workers.dev. The old address redirects here.
  // Storage keeps its original names (studypoint-db, passages-v1); renaming them would mean migrating data for no benefit.
  "name": "studyflare",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  // Served at studypoint.<subdomain>.workers.dev (ARCHITECTURE A2). Cloudflare Access is enabled on this route in T0.07.
  "workers_dev": true,
  // Per-version preview URLs would bypass the Access policy on the main route. Off until the protected
  // preview environment exists (T0.05/T0.07).
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // EXP-02: nightly backup at 08:00 UTC (about 03:00 in Maryland in winter, 04:00 in summer).
  "triggers": { "crons": ["0 8 * * *"] },
  // Auth (AUTH-01..05): Access app "Studyflare" (passkey or email PIN, 30-day sessions, "Studyflare owner"
  // policy). These values are public identifiers, not secrets. ALLOWED_EMAILS and OWNER_EMAILS are Worker
  // SECRETS; never put them here.
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "shrill-hat-b870.cloudflareaccess.com",
    "ACCESS_AUD": "70ec5742ef21a1fbb6e1514cebcf3ef8a1719921cf5befd0c2b74290dfbb2ff4",
    // Step 5 (2026-11-27): which Workers AI model does each task ("Balanced" tier, Alex's choice). Model IDs
    // live ONLY here (AGENTS 3). Switch "answer"/"generate" to larger models once on Workers Paid.
    "AI_MODELS": "{\"answer\":\"@cf/openai/gpt-oss-120b\",\"generate\":\"@cf/openai/gpt-oss-120b\",\"validate\":\"@cf/openai/gpt-oss-20b\",\"grade\":\"@cf/openai/gpt-oss-20b\",\"embed\":\"@cf/baai/bge-m3\",\"ocr\":\"@cf/meta/llama-4-scout-17b-16e-instruct\"}"
  },
  // Workers AI (step 5). Personal content only ever goes here, never to a provider that trains on it (PRV-02).
  "ai": { "binding": "AI" },
  // T0.05: storage. Created 2026-11-26; 0001_init.sql applied (schema fingerprint verified against the file).
  // R2 (FILES), Workers AI (AI) and the ingestion Workflow are added once Workers Paid is active.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studypoint-db",
      "database_id": "a2d32ddc-edcf-4c58-9943-89c43355e4ce",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [{ "binding": "VEC", "index_name": "passages-v1" }],
  // Step 2b (2026-11-26): uploaded files, ENCRYPTED in the browser and stored in 4 MiB chunks under
  // files/<user>/<version>/<n>. Nightly backups also go here, under backups/.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "studypoint-files" }],
  "env": {
    // Preview: separate data everywhere (IMPLEMENTATION §2). Bindings and vars are not inherited, so all are repeated.
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studypoint-preview",
          "database_id": "3239de5f-bc52-43e5-949a-5ed8e2ff2b52",
          "migrations_dir": "migrations"
        }
      ],
      "vectorize": [{ "binding": "VEC", "index_name": "passages-preview" }]
    }
  }
}
