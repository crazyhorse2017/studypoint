{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studypoint",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  // Served at studypoint.<subdomain>.workers.dev (ARCHITECTURE A2). Cloudflare Access is enabled on this route in T0.07.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // D1, R2, Vectorize, Workers AI and Workflow bindings plus the `preview` env are added in T0.05.
}
